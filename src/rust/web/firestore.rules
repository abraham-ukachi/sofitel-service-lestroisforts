//
// @project: sofitel-service-lestroisforts
// @name: Les Trois Forts - Firestore Security Rules
// @file: rust/web/firestore.rules
// @type: Firebase Security Rules
// @authors: Abraham Ukachi <abrahamukachi@gmail.com>
//
// Example usage:
//   1+|> Firebase console > Firestore Database > Rules > paste this file > Publish
//    -|>
//
// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
// MOTTO: We'll always do more 😜!!!
// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
//
// 🛡️ Who may do what:
// - users/{uid}    : my own progress & settings, only me.
// - team/{uid}     : the approved team. Only admins add / remove / promote. The owner is always an admin.
// - requests/{uid} : "let me into the chat" requests. Made by the person, read & answered by admins.
// - chat/{id}      : team members only, every field checked (no HTML tricks, no fake authors, server time).
// - push/{uid}     : my own devices; team members (and newcomers, for admins only) can read for the push server.
// - pushlog/{id}   : one row per announced message / request, so a push can never be replayed.
// - board/{uid}    : the team leaderboard (XP, month base, streak, mastered, answers, exam, XP per day & activity), teammates only, my own row only.
// - sim/{code}     : an online « Simulation de service » game (4-digit code, 6 hours), team members only, small checked writes.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPERS 🧰 ===== //

    // 🔐 signed in with Google
    function signedIn() {
      return request.auth != null;
    }
    // 👑 the owner (verified Google email)
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'abrahamukachi@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // the path of a team doc
    function teamPath(uid) {
      return /databases/$(database)/documents/team/$(uid);
    }
    // 👥 an approved member (or the owner)
    function isMember() {
      return signedIn() && (isOwner() || exists(teamPath(request.auth.uid)));
    }
    // 🎖️ an admin (or the owner)
    function isAdmin() {
      return signedIn()
        && (isOwner() || (exists(teamPath(request.auth.uid)) && get(teamPath(request.auth.uid)).data.role == 'admin'));
    }
    // 🔤 a text field of at most `max` characters
    function isText(value, max) {
      return value is string && value.size() <= max;
    }
    // 🖼️ a Google profile photo address (or none)
    function isPicture(value) {
      return value == '' || (isText(value, 500) && value.matches('^https://[a-z0-9.-]+[.]googleusercontent[.]com/[^"<> ]*$'));
    }

    // ===== MY PROGRESS 📈 ===== //
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // 🛠️ the owner's dashboard reads every account & can delete one (XP reset)
      allow read, delete: if isOwner();
    }

    // ===== TEAM LEADERBOARD 🏆 ===== //
    match /board/{uid} {
      // teammates see everybody's score
      allow read: if isMember();
      // my own score only, whole numbers, this month's base never above my XP, server time
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'pic', 'xp', 'base', 'month', 'streak', 'mastered', 'right', 'wrong', 'exam', 'days', 'modes', 'ts'])
        && isText(request.resource.data.name, 60)
        && isPicture(request.resource.data.pic)
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 10000000
        && request.resource.data.base is int && request.resource.data.base >= 0
        && request.resource.data.base <= request.resource.data.xp
        && request.resource.data.month is string && request.resource.data.month.matches('^20[0-9]{2}-[01][0-9]$')
        && request.resource.data.streak is int && request.resource.data.streak >= 0 && request.resource.data.streak <= 100000
        && request.resource.data.mastered is int && request.resource.data.mastered >= 0 && request.resource.data.mastered <= 100000
        && request.resource.data.get('right', 0) is int && request.resource.data.get('right', 0) >= 0
        && request.resource.data.get('wrong', 0) is int && request.resource.data.get('wrong', 0) >= 0
        && request.resource.data.get('exam', 0) is int && request.resource.data.get('exam', 0) >= 0 && request.resource.data.get('exam', 0) <= 100
        && request.resource.data.get('days', {}) is map && request.resource.data.get('days', {}).size() <= 31
        && request.resource.data.get('modes', {}) is map && request.resource.data.get('modes', {}).size() <= 7
        && request.resource.data.ts == request.time;
      // I can leave the board, admins can clean it up
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ===== THE TEAM 👥 ===== //
    match /team/{uid} {
      // members see the team; anyone signed in may see who the admins are (to ping them) and their own doc
      allow read: if isMember()
        || (signedIn() && request.auth.uid == uid)
        || (signedIn() && resource.data.role == 'admin');
      // admins add / promote people (the owner may add himself first)
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'pic', 'role', 'by', 'ts'])
        && request.resource.data.role in ['member', 'admin']
        && isText(request.resource.data.name, 100)
        && isText(request.resource.data.email, 200)
        && isPicture(request.resource.data.pic)
        && request.resource.data.by == request.auth.uid
        && (resource == null || resource.data.email != 'abrahamukachi@gmail.com' || isOwner());
      // admins remove people, but nobody removes the owner
      allow delete: if isAdmin() && resource.data.email != 'abrahamukachi@gmail.com';
    }

    // ===== ACCESS REQUESTS 🙋 ===== //
    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // I ask once, with my real email & a server time
      allow create: if signedIn() && request.auth.uid == uid && !isMember()
        && request.resource.data.keys().hasOnly(['name', 'email', 'pic', 'ts'])
        && isText(request.resource.data.name, 100)
        && request.resource.data.email == request.auth.token.email
        && isPicture(request.resource.data.pic)
        && request.resource.data.ts == request.time;
      // admins refuse (the flag only)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refused'])
        && request.resource.data.refused == true;
      // admins clear it after approving; I may withdraw mine unless it was refused
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.get('refused', false) != true);
    }

    // ===== TEAM CHAT 💬 ===== //
    match /chat/{id} {
      allow read: if isMember();
      // a new message: plain auto id, my uid, server time, every field checked 🛡️
      allow create: if isMember()
        && id.matches('^[A-Za-z0-9]{1,40}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'pic', 'text', 'img', 'gif', 'sticker', 'rep', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && isText(request.resource.data.name, 100)
        && isPicture(request.resource.data.pic)
        && isText(request.resource.data.text, 1000)
        && (!('img' in request.resource.data)
          || (request.resource.data.img is string
            && request.resource.data.img.size() < 1000000
            && request.resource.data.img.split(',').size() == 2
            && request.resource.data.img.split(',')[0] == 'data:image/jpeg;base64'))
        && (!('gif' in request.resource.data)
          || (isText(request.resource.data.gif, 500)
            && request.resource.data.gif.matches('^https://media[0-9]?[.]giphy[.]com/[A-Za-z0-9/_.?=&-]+$')))
        && (!('sticker' in request.resource.data)
          || (isText(request.resource.data.sticker, 40) && request.resource.data.sticker.matches('^[a-z0-9-]+$')))
        && (!('rep' in request.resource.data)
          || (request.resource.data.rep is map
            && request.resource.data.rep.keys().hasOnly(['id', 'uid', 'name', 'text'])
            && request.resource.data.rep.id.matches('^[A-Za-z0-9]{1,40}$')
            && isText(request.resource.data.rep.get('uid', ''), 128)
            && isText(request.resource.data.rep.get('name', ''), 100)
            && isText(request.resource.data.rep.get('text', ''), 200)));
      // a reaction: only `r.<my uid>`, one short emoji
      allow update: if (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
        && request.resource.data.r is map
        && request.resource.data.r.diff(resource.data.get('r', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.r) || isText(request.resource.data.r[request.auth.uid], 16)))
      // ✏️ or an edit of my own text, within 5 minutes, marked with the server time (0.69.0)
        || (isMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'ed'])
        && isText(request.resource.data.text, 1000)
        && request.resource.data.text.size() > 0
        && request.resource.data.ed == request.time
        && request.time < resource.data.ts + duration.value(5, 'm'));
      // my own messages (admins may also remove any message)
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ===== CHAT PHASE 3 🎤📊🔁 (voice notes, polls, shift handover, votes; 0.70.0) ===== //
    // a second chat block: Firestore ORs it with the one above, and it repeats every check of a new message
    match /chat/{id} {
      allow create: if isMember()
        && id.matches('^[A-Za-z0-9]{1,40}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'pic', 'text', 'img', 'rep', 'ts', 'voice', 'dur', 'poll', 'ho'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && isText(request.resource.data.name, 100)
        && isPicture(request.resource.data.pic)
        && isText(request.resource.data.text, 1000)
        && !('img' in request.resource.data)
        && (!('rep' in request.resource.data)
          || (request.resource.data.rep is map
            && request.resource.data.rep.keys().hasOnly(['id', 'uid', 'name', 'text'])
            && request.resource.data.rep.id.matches('^[A-Za-z0-9]{1,40}$')
            && isText(request.resource.data.rep.get('uid', ''), 128)
            && isText(request.resource.data.rep.get('name', ''), 100)
            && isText(request.resource.data.rep.get('text', ''), 200)))
        && (!('voice' in request.resource.data)
          || (request.resource.data.voice is string
            && request.resource.data.voice.size() < 700000
            && request.resource.data.voice.split(',').size() == 2
            && request.resource.data.voice.split(',')[0].matches('^data:audio/(webm|mp4|ogg|aac|mpeg)(;codecs=[a-z0-9.]+)?;base64$')))
        && (!('dur' in request.resource.data)
          || (request.resource.data.dur is int && request.resource.data.dur >= 1 && request.resource.data.dur <= 60))
        && (!('poll' in request.resource.data)
          || (request.resource.data.poll is map
            && request.resource.data.poll.keys().hasOnly(['q', 'o'])
            && isText(request.resource.data.poll.q, 200)
            && request.resource.data.poll.o is list
            && request.resource.data.poll.o.size() >= 2
            && request.resource.data.poll.o.size() <= 6))
        && (!('ho' in request.resource.data) || request.resource.data.ho == true);
      // 📊 a vote: only `v.<my uid>`, an option number 0-5
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v'])
        && request.resource.data.v is map
        && request.resource.data.v.diff(resource.data.get('v', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.v)
          || (request.resource.data.v[request.auth.uid] is int
            && request.resource.data.v[request.auth.uid] >= 0
            && request.resource.data.v[request.auth.uid] <= 5));
    }

    // ===== TYPING ✍️ (« Ourya écrit… », 0.69.0) ===== //
    match /typing/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && isText(request.resource.data.name, 100)
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ===== SEEN 👀 (how far each teammate has read, 0.69.0) ===== //
    match /seen/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'pic', 'at'])
        && isText(request.resource.data.name, 100)
        && isPicture(request.resource.data.pic)
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ===== PUSH DEVICES 📲 ===== //
    match /push/{uid} {
      allow read: if isMember()
        || (signedIn() && request.auth.uid == uid)
        || (signedIn() && exists(teamPath(uid)) && get(teamPath(uid)).data.role == 'admin');
      allow write: if signedIn() && request.auth.uid == uid;
      // 🛠️ the owner can remove a device
      allow delete: if isOwner();
    }

    // ===== PUSH LOG 🔒 (one push per message / request, never twice) ===== //
    match /pushlog/{key} {
      // 🛠️ the owner's dashboard counts the pushes sent
      allow read: if isOwner();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['at'])
        && (key == 'req_' + request.auth.uid
          || (isMember()
            && exists(/databases/$(database)/documents/chat/$(key))
            && get(/databases/$(database)/documents/chat/$(key)).data.uid == request.auth.uid));
    }

    // ===== SERVICE SIMULATION 🛎️ (online game « Simulation de service », 4-digit code, lives 6 hours) ===== //
    // the floor plan's tables (LTF.tables): the only keys allowed in `tb` (tables) & `rq` (permission requests)
    function simTableIds() {
      return ['T25', 'T24', 'T23', 'T22', 'T21', 'T33', 'T32', 'T31', 'T30', 'T100', 'T20', 'T34', 'B1', 'T35', 'T14', 'B2', 'T15', 'T12', 'B3', 'T16', 'T11', 'T17', 'T19', 'T18', 'T10'];
    }
    // ⏳ the game is less than 6 hours old
    function simAlive() {
      return request.time < resource.data.at + duration.value(6, 'h');
    }
    // 🆕 a brand-new game: the host alone, bookings & rangs as JSON text, no table yet, clock not started, server time
    function isNewSimGame(data) {
      return data.keys().hasOnly(['v', 'host', 'n', 'bk', 'rg', 'wt', 'tb', 'rq', 'st', 'at'])
        && data.v == 1
        && data.host == request.auth.uid
        && data.n is int && data.n >= 1 && data.n <= 4
        && isText(data.bk, 30000)
        && isText(data.rg, 2000)
        && data.wt is map && data.wt.keys().hasOnly([request.auth.uid])
        && data.wt[request.auth.uid].keys().hasOnly(['n', 'i'])
        && isText(data.wt[request.auth.uid].n, 60)
        && data.wt[request.auth.uid].i == 0
        && data.tb is map && data.tb.size() == 0
        && data.rq is map && data.rq.size() == 0
        && data.st == null
        && data.at == request.time;
    }
    match /sim/{code} {
      // team members read a live game (a missing code reads as "not found"); the owner's dashboard reads them all
      allow read: if isMember() && (resource == null || simAlive());
      allow read: if isOwner();
      // the host creates a game under a free 4-digit code
      allow create: if isMember() && code.matches('^[0-9]{4}$') && isNewSimGame(request.resource.data);
      // an expired code (older than 6 hours) can be reused by a new game
      allow update: if isMember() && !simAlive() && isNewSimGame(request.resource.data);
      // 🙋 join: only my own waiter entry (name + rang number below the game's waiter count), 4 waiters at most
      allow update: if isMember() && simAlive()
        && !(request.auth.uid in resource.data.wt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wt'])
        && request.resource.data.wt.diff(resource.data.wt).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.wt.size() <= 4
        && request.resource.data.wt[request.auth.uid].keys().hasOnly(['n', 'i'])
        && isText(request.resource.data.wt[request.auth.uid].n, 60)
        && request.resource.data.wt[request.auth.uid].i is int
        && request.resource.data.wt[request.auth.uid].i >= 0
        && request.resource.data.wt[request.auth.uid].i < resource.data.n;
      // 🍽️ play: the game's waiters change tables (steal included) & requests, keys = real table ids only;
      // only the host starts the clock, once, with the server time
      allow update: if isMember() && simAlive()
        && request.auth.uid in resource.data.wt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tb', 'rq', 'st'])
        && request.resource.data.tb is map && request.resource.data.tb.keys().hasOnly(simTableIds())
        && request.resource.data.rq is map && request.resource.data.rq.keys().hasOnly(simTableIds())
        && (!('st' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.auth.uid == resource.data.host && resource.data.st == null && request.resource.data.st == request.time));
      // the host closes the game; anyone on the team may clear an expired one
      allow delete: if isMember() && (resource.data.host == request.auth.uid || !simAlive());
    }

    // ===== LIVE CONTENT 📝 (the owner edits the menu in the dashboard, everybody reads it) ===== //
    match /content/{section} {
      allow read: if true;
      allow create, update: if isOwner()
        && section.matches('^[A-Za-z]{1,20}$')
        && request.resource.data.keys().hasOnly(['data', 'ts'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.ts == request.time;
      allow delete: if isOwner();
    }

    // ===== CONFIG ⚙️ (the team announcement, the XP resets) ===== //
    match /config/announce {
      allow read: if true;
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['text', 'on', 'ts'])
        && isText(request.resource.data.text, 500)
        && request.resource.data.on is bool
        && request.resource.data.ts == request.time;
    }
    match /config/resets {
      allow read: if signedIn();
      allow write: if isOwner() && request.resource.data.size() <= 500;
    }
  }
}
